# Copying is optional: deploy/scripts/stack.ps1 creates deploy/env/.env.local
# with random local-only secrets on first run.

COMPOSE_PROJECT_NAME=citysafe-local
CITYSAFE_GATEWAY_IMAGE=citysafe-gateway
CITYSAFE_IMAGE_TAG=local
POSTGRES_IMAGE=postgres:16.4-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
NGINX_IMAGE=nginx:1.27-alpine

POSTGRES_DB=citysafe
POSTGRES_USER=citysafe
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_POSTGRES

MINIO_ROOT_USER=citysafe_root
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL_MINIO_ROOT
MINIO_ACCESS_KEY=citysafe_local
MINIO_SECRET_KEY=CHANGE_ME_LOCAL_MINIO_APP
MINIO_BUCKET=team-shared

CITYSAFE_ENV=development
AUTH_REQUIRED=1
AUTH_SIGNING_SECRET=CHANGE_ME_LOCAL_AUTH
AUTH_SESSION_TTL_SECONDS=28800
AUTH_LOGIN_MAX_ATTEMPTS=0
AUTH_LOGIN_LOCK_SECONDS=0
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=本地管理员
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ADMIN_PASSWORD
MLOPS_TOKEN=CHANGE_ME_LOCAL_MLOPS
ANNOTATION_UPLOAD_TOKEN=CHANGE_ME_LOCAL_ANNOTATION
DATASET_UPLOAD_TOKEN=CHANGE_ME_LOCAL_DATASET

CITYSAFE_HTTP_PORT=8080
MINIO_CONSOLE_PORT=9001
PUBLIC_ORIGIN=http://127.0.0.1:8080
CORS_ALLOW_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
MINIO_PUBLIC_UPLOAD_PREFIX=http://127.0.0.1:8080/minio-upload
MINIO_ALLOW_INSECURE_PRESIGN=1

APP_ENV=local
SHOW_DEMO_ACCOUNTS=false
GATEWAY_AUTH_ENABLED=true
API_PROXY=
ANNOTATION_STORAGE_BUCKET=annotations

MAX_JSON_BODY_BYTES=2097152
MAX_UPLOAD_BYTES=209715200
MAX_DATASET_BYTES=53687091200
DATASET_CHUNK_SIZE=8388608
LOG_LEVEL=INFO
