# Store the filled server file outside the repository, for example:
#   /etc/citysafe/server.env
# Never copy local demo secrets or data into this file.

COMPOSE_PROJECT_NAME=citysafe
CITYSAFE_GATEWAY_IMAGE=citysafe-gateway
CITYSAFE_IMAGE_TAG=CHANGE_ME_RELEASE_TAG
POSTGRES_IMAGE=postgres:16.4-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
NGINX_IMAGE=nginx:1.27-alpine

POSTGRES_DB=citysafe
POSTGRES_USER=citysafe
POSTGRES_PASSWORD=CHANGE_ME_SERVER_POSTGRES

MINIO_ROOT_USER=citysafe_root
MINIO_ROOT_PASSWORD=CHANGE_ME_SERVER_MINIO_ROOT
MINIO_ACCESS_KEY=citysafe_app
MINIO_SECRET_KEY=CHANGE_ME_SERVER_MINIO_APP
MINIO_BUCKET=team-shared

CITYSAFE_ENV=production
AUTH_REQUIRED=1
AUTH_SIGNING_SECRET=CHANGE_ME_SERVER_AUTH
AUTH_SESSION_TTL_SECONDS=28800
# 小团队内网使用可设为 0 关闭登录失败锁定；正式公网建议恢复 5 / 900
AUTH_LOGIN_MAX_ATTEMPTS=0
AUTH_LOGIN_LOCK_SECONDS=0
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_SERVER_ADMIN_PASSWORD
MLOPS_TOKEN=CHANGE_ME_SERVER_MLOPS
ANNOTATION_UPLOAD_TOKEN=CHANGE_ME_SERVER_ANNOTATION
DATASET_UPLOAD_TOKEN=CHANGE_ME_SERVER_DATASET

SERVER_NAME=citysafe.example.com
PUBLIC_ORIGIN=https://citysafe.example.com
CORS_ALLOW_ORIGINS=https://citysafe.example.com
MINIO_PUBLIC_UPLOAD_PREFIX=https://citysafe.example.com/minio-upload
MINIO_ALLOW_INSECURE_PRESIGN=0
TLS_CERT_ROOT=/etc/letsencrypt
CITYSAFE_HTTP_BIND=0.0.0.0
CITYSAFE_HTTPS_BIND=0.0.0.0

APP_ENV=production
SHOW_DEMO_ACCOUNTS=false
GATEWAY_AUTH_ENABLED=true
API_PROXY=
ANNOTATION_STORAGE_BUCKET=annotations

MAX_JSON_BODY_BYTES=2097152
MAX_UPLOAD_BYTES=209715200
MAX_DATASET_BYTES=53687091200
DATASET_CHUNK_SIZE=8388608
LOG_LEVEL=INFO
