# /etc/cron.d/citysafe
# Before installation, set CITYSAFE_REPO_ROOT to the server checkout path.
# Install with:
#   sudo cp deploy/cron/citysafe.cron /etc/cron.d/citysafe
#   sudo chmod 0644 /etc/cron.d/citysafe

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

CITYSAFE_REPO_ROOT=/opt/city-safety-team-system
CITYSAFE_ENV_FILE=/etc/citysafe/server.env
BACKUP_ROOT=/srv/citysafe/backups

# Full-stack backup. Root is required for the private maintenance lock and
# isolated Docker volume access.
0 2 * * * root cd "$CITYSAFE_REPO_ROOT" && /usr/bin/env CITYSAFE_ENV_FILE="$CITYSAFE_ENV_FILE" BACKUP_ROOT="$BACKUP_ROOT" /bin/bash deploy/scripts/backup.sh >> /var/log/citysafe-backup.log 2>&1

# Weekly isolated recovery verification, after the daily backup window.
30 3 * * 0 root cd "$CITYSAFE_REPO_ROOT" && /usr/bin/env CITYSAFE_ENV_FILE="$CITYSAFE_ENV_FILE" BACKUP_ROOT="$BACKUP_ROOT" /bin/bash deploy/scripts/restore-verify.sh >> /var/log/citysafe-restore-verify.log 2>&1
