{
  "name": "patent-management-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "python start_web.py",
    "build": "python build_assets.py",
    "build:check": "python build_assets.py --check",
    "lint": "eslint js/*.js server.cjs proxy_server.js worker.js --max-warnings 0",
    "test": "python -m unittest discover -s tests -p test_*.py",
    "check": "npm run lint && npm run test && npm run build:check",
    "server": "node server.cjs",
    "server:python": "python working_proxy.py"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1"
  }
}
