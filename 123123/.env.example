# 本文件只提交占位符。部署时复制为 .env 并填写真实值，禁止提交 .env。

# 推荐架构：网关直连 PostgreSQL。Docker Compose 会自动填入这些 PG* 变量。
DATA_BACKEND=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=citysafe
PGUSER=citysafe
PGPASSWORD=
CITYSAFE_DATA_DIR=

# 仅用于从旧 Supabase 架构过渡；新部署保持为空。
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 服务端身份认证与首次管理员。密钥至少 32 字节，禁止提交真实值。
CITYSAFE_ENV=development
AUTH_REQUIRED=1
AUTH_SIGNING_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_ACCOUNT_CACHE_SECONDS=30
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=
# 生产也可改用只读 Docker secret 文件：
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password

# MLOps 上报写接口 token。必须配置，否则 /api/mlops/report 拒绝写入。
MLOPS_TOKEN=

# 标注、数据集与 MLOps 的服务端令牌，不得写入任何前端配置。
ANNOTATION_UPLOAD_TOKEN=

DATASET_UPLOAD_TOKEN=

# 标注云端共享桶名称（需先执行 supabase_annotations_storage.sql）
ANNOTATION_STORAGE_BUCKET=annotations

# 单文件上传上限，默认 200MB（标注接口）。
MAX_UPLOAD_BYTES=209715200

# 数据集单文件上限，默认 10GB。
MAX_DATASET_BYTES=10737418240

# 数据集分片大小，默认 2MB。
DATASET_CHUNK_SIZE=2097152

# JSON/API 普通请求体上限，默认 2MB，防止非文件接口耗尽内存。
MAX_JSON_BODY_BYTES=2097152

# 允许上传的扩展名，按业务需要收敛。
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.webp,.gif,.txt,.xml,.csv,.json,.yaml,.yml

# 数据集允许扩展名
DATASET_ALLOWED_EXTENSIONS=.csv,.tsv,.json,.xml,.zip,.jpg,.jpeg,.png,.bmp,.webp,.xlsx,.xls,.txt,.yaml,.yml

# 团队共享文件存储后端：local（默认磁盘）或 minio（S3 兼容对象存储）
SHARED_STORAGE_BACKEND=local

# MinIO / S3 兼容配置（仅当 SHARED_STORAGE_BACKEND=minio 时生效）
# 需安装：pip install minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=team-shared
MINIO_SECURE=false
MINIO_REGION=us-east-1
# 预签名有效期（秒）；对外上传前缀经 Nginx /minio-upload/ 反代（生产填写）
MINIO_PRESIGN_EXPIRE=600
# MINIO_PUBLIC_UPLOAD_PREFIX=https://YOUR_DOMAIN/minio-upload
# MINIO_PRESIGN_MAX_BYTES=53687091200

# 网关默认仅监听本机且不开放跨域。跨域来源支持逗号分隔白名单。
BIND_HOST=127.0.0.1
# CORS_ALLOW_ORIGINS=https://YOUR_DOMAIN,https://admin.YOUR_DOMAIN
# 仅临时本机开发可设为 1；生产严禁开启。开启后也只放行 loopback 客户端。
ALLOW_INSECURE_LOCAL_WRITES=0
# CITYSAFE_NO_BROWSER=1

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 百度 OCR（文档/专利证书识别用，server.cjs / proxy_server.js）。
# 在百度智能云控制台申请，禁止提交真实值。
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 可选 ClamAV 病毒扫描（本地开发保持 0；生产见 deploy/scripts/clamav-setup-notes.md）
CLAMAV_SCAN=0
CLAMSCAN_BIN=clamdscan
